{
  "title": "OTel Stack Health (M5.9 starter)",
  "uid": "otel-stack-health",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Collector scrape target up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "up{job=\"otel-collector\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Collector scrape duration (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "scrape_duration_seconds{job=\"otel-collector\"}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Recent traces (Tempo)",
      "type": "traces",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
      "targets": [
        { "queryType": "search", "limit": 20, "refId": "A" }
      ]
    }
  ]
}
