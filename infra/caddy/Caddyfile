# Real local HTTPS (Caddy's internal CA, not public ACME -- *.localhost isn't
# a real domain). Required because Keycloak marks its session cookies Secure;
# over plain HTTP those get silently dropped once the hostname isn't literally
# "localhost" (which browsers/curl treat as an implicit secure context, but
# only that exact name). See KNOWN-ISSUES.md. The CA's private key lives in
# the caddy-data volume (docker-compose.yml) -- must persist across restarts,
# or every restart mints a new CA the OS/browser no longer trusts.
#
# eaop-logistics.localhost namespacing (not a bare *.localhost) avoids colliding
# with any other project's generically-named "ops-dashboard"/"keycloak" local
# service. Windows' hosts file has no wildcard support, so each subdomain
# still needs its own literal hosts-file line -- see infra/caddy/README.md.

# Shared friendly error page for upstream-down cases (502/503/504) -- the mock
# services/ops-dashboard run as plain host processes (uv run ... serve), not
# containers Caddy manages, so "backend not started/crashed yet" is a routine
# dev-loop state, not a real outage. A raw Caddy 502 gives no hint of that;
# this names the actual likely cause instead.
(friendly_errors) {
    handle_errors {
        @upstream_down expression {err.status_code} in [502, 503, 504]
        respond @upstream_down "Backend not reachable ({err.status_code}). It's probably not started yet -- run `uv run <system> serve --port <port>` for the service behind {host}, then reload." 502
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}

# ops-dashboard: read-only cross-cutting dashboard. Proxies to the app
# running on the host (uv run ops-dashboard serve, :8006) --
# host.docker.internal is Docker Desktop's route from a container back to
# the host.
https://ops-dashboard.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy host.docker.internal:8006
}

# QMS: API + its own frontend in one process (uv run mock-qms serve, :8007)
# -- unlike ops-dashboard, not a separate reader; the UI lives at /app on
# the same port as the JSON API.
https://qms.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy host.docker.internal:8007
}

# Keycloak (dev IdP) -- fronted here too so the OIDC issuer is a stable name,
# not a bare port. Keycloak's start-dev derives the `iss` claim from whichever
# Host header reached it (no KC_HOSTNAME set), so every caller -- browser, the
# dashboard's backend token exchange, this Caddy proxy itself -- must
# consistently use keycloak.eaop-logistics.localhost, never localhost:8081
# directly, or issued tokens' `iss` won't match what verify_with_jwks() expects.
https://keycloak.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy host.docker.internal:8081
}
