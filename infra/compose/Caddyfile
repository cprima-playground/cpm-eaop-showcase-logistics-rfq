# The Inspector client's browser JS calls the proxy server directly
# (client/src/utils/configUtils.ts's getMCPProxyAddress) -- same-hostname
# different-port by default, which doesn't work through a single-port
# gateway. Needs its own vhost; set "Inspector Proxy Address" to this
# URL in the Inspector UI's config sidebar (MCP_PROXY_FULL_ADDRESS) once
# per browser -- exactly the "non-default proxy address" case that field
# exists for.
https://mcp-inspector-proxy.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy mcp-inspector:6277
}

https://web.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy web:80
}
