# Caddyfile for the SUPPORT+SHOWCASE compose split (infra/compose.support.yaml
# + infra/compose.showcase.yaml) -- mounted by compose.support.yaml's caddy
# service. Distinct from infra/caddy/Caddyfile (the older standalone setup, which
# fronts bare HOST PROCESSES via host.docker.internal -- still valid for
# piecemeal local dev). Here every backend is a container on the SAME
# compose network, so reverse_proxy targets are compose SERVICE NAMES, not
# host.docker.internal.
#
# Caddy is authoritative external ingress only. Peer service-to-service
# traffic (agent -> MCP, MCP -> backend) does NOT hairpin through Caddy --
# it uses compose's own internal DNS directly (see infra/compose.yaml's
# per-service environment: blocks). This file exists purely for external
# reachability + the "one entry point, hostname-based identity" showcase
# property (tmp/caddy-first-routing-analysis.md).

(friendly_errors) {
    handle_errors {
        @upstream_down expression {err.status_code} in [502, 503, 504]
        respond @upstream_down "Backend not reachable ({err.status_code}). It's probably still starting -- check `docker compose -f infra/compose.yaml ps`." 502
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}

https://ops-dashboard.eaop-logistics.localhost {
    import friendly_errors
    reverse_proxy ops-dashboard:8006
}

