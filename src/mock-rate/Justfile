# mock-rate -- convenience wrapper over `uv run mock-rate ...` / pytest.
# `serve` boots the process; every other command (except test) talks to a
# *running* one over HTTP (see mock_rate/cli.py's docstring for why).

default:
    @just --list

serve:
    uv run mock-rate serve

test:
    uv run pytest

reset:
    uv run mock-rate reset

rates:
    uv run mock-rate rates

stats:
    uv run mock-rate stats
