# mock-tms -- convenience wrapper over `uv run mock-tms ...` / pytest.
# `serve` boots the process; every other command (except test) talks to a
# *running* one over HTTP (see mock_tms/cli.py's docstring for why).

default:
    @just --list

serve:
    uv run mock-tms serve

test:
    uv run pytest

reset:
    uv run mock-tms reset

routes:
    uv run mock-tms routes

stats:
    uv run mock-tms stats
