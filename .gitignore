# Python
.venv/
__pycache__/
*.pyc

# Local env overrides (e.g. DOCKER_BUILDCACHE_DIR) -- machine-specific, not shared config
.env

# BuildKit cache_to export target, default location when DOCKER_BUILDCACHE_DIR
# unset OR the .env lookup silently misses (compose's .env auto-lookup keys
# off the FIRST -f file's directory, not invocation cwd or DOCKER_BUILDCACHE_DIR's
# own home -- found live: without --env-file, this landed a 6.5GB copy at
# repo root, inside the Docker build context for every service using it).
# Both locations covered since the failure mode isn't hypothetical.
.buildcache/
infra/.buildcache/

# Terraform (infra/keycloak/terraform) -- state is local dev state, not IaC
# source; the CA cert path in config.py's caddy_ca_bundle() docstring is the
# same story: extracted per-machine via `docker cp`, not committed.
.terraform/
*.tfstate
*.tfstate.backup
infra/entra/terraform.tfvars

# Caddy's internal CA root cert -- extracted manually via docker cp, unique
# per caddy-data volume instance, never committed (see config.py's
# caddy_ca_bundle()).
infra/caddy/root.crt
infra/keycloak/terraform/tfplan
tmp/

# Per-machine GCP target for the hello-agent-adk spike -- whichever project/
# bucket you're pointed at (personal sandbox vs. an employer sandbox), never
# a fixed value to commit.
spikes/hello-agent-adk/gcp.env
