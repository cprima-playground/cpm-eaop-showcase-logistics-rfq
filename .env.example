# Copy to .env (gitignored, machine-local) and adjust as needed.
# Every host-published port used by infra/compose.support.yaml and
# infra/observability/docker-compose.yml is listed here -- the port
# REGISTRY for this repo. Container-internal ports are NOT listed: they
# never collide (each container has its own network namespace) and aren't
# meant to be overridden, so they're not env-vars, just fixed values in
# each compose file / service Dockerfile.
#
# gateway's 443 is deliberately NOT overridable here -- every documented
# https://*.eaop-logistics.localhost URL assumes the browser default HTTPS
# port; changing it would break every hostname reference across the repo
# for no local benefit.

# BuildKit cache_to export target -- point at a fast/large drive if the
# in-repo default (infra/.buildcache) isn't right for this machine.
DOCKER_BUILDCACHE_DIR=T:/docker-buildcache

# --- infra/compose.support.yaml -------------------------------------------
KEYCLOAK_HOST_PORT=8081
VAULT_HOST_PORT=8200

# --- infra/observability/docker-compose.yml --------------------------------
TEMPO_HOST_PORT=3200
# Overriding these also needs a matching change to rfq_common.observability's
# OTEL_EXPORTER_OTLP_ENDPOINT default for any host-run (non-Docker) process --
# that default assumes localhost:4317, independent of this env var.
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
